# Copy to .env on the server. Only needed for the HTTPS profile.
DOMAIN=prices.example.com
BASIC_AUTH_USER=admin
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_HASH='$2a$14$replace-me'
PA_POLL_MINUTES=30
PA_NEWS_HOURS=12
