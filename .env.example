# Copy to .env on the server. Only needed for the HTTPS profile. deploy/setup.sh writes this file for you.
DOMAIN=prices.example.com
# Optional DuckDNS: keeps the name pointing at this server (deploy/duckdns-update.sh runs every 5 minutes)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
PA_POLL_MINUTES=30
PA_NEWS_HOURS=12
